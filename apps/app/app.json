{
  "expo": {
    "name": "Itera",
    "slug": "itera",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "itera",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.itera.ios",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Itera utilise Face ID pour protéger l'accès à vos cartes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "app.itera.android",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E9E7FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Itera",
      "shortName": "Itera",
      "lang": "fr",
      "themeColor": "#5B4BFF",
      "backgroundColor": "#E9E7FF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-local-authentication", { "faceIDPermission": "Itera utilise Face ID pour protéger l'accès à vos cartes." }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9E7FF",
          "dark": { "backgroundColor": "#07071A" },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
