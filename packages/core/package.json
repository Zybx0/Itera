{
  "name": "@itera/core",
  "version": "0.1.0",
  "private": true,
  "description": "Itera domain logic: data model, FSRS scheduling, encryption, storage abstraction, export/import. Platform-agnostic (no React, no Expo).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
